rules_version = '2';
// Pelada FC · regras de segurança do Firestore
// Cole este texto inteiro em: Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function eu() { return request.auth.uid; }
    function donoDoApp() { return logado() && request.auth.token.email != null && request.auth.token.email.lower() in get(/databases/$(database)/documents/servidor/plataforma).data.get('emails', []); }
    function grupo(gid) { return get(/databases/$(database)/documents/grupos/$(gid)).data; }
    function grupoDepois(gid) { return getAfter(/databases/$(database)/documents/grupos/$(gid)).data; }
    function admin(gid) { return logado() && exists(/databases/$(database)/documents/grupos/$(gid)) && eu() in grupo(gid).admins; }
    function adminDepois(gid) { return logado() && eu() in grupoDepois(gid).admins; }
    function membro(gid) { return logado() && exists(/databases/$(database)/documents/grupos/$(gid)/membros/$(eu())); }

    // Perfil de cada pessoa: só ela lê e escreve.
    match /users/{uid} {
      allow read, write: if logado() && eu() == uid;
      // Celulares inscritos para receber notificações: cada pessoa só mexe nos seus.
      match /push/{id} {
        allow read, write: if logado() && eu() == uid;
      }
    }

    // Chaves do servidor de notificações: só o servidor acessa (o app não lê nem grava).
    // Registro técnico de erros do app: quem está logado só cria (sem nome, e-mail, CPF ou telefone); ler e apagar, só o dono do app.
    match /erros/{id} {
      allow create: if logado()
        && request.resource.data.uid == eu()
        && request.resource.data.keys().hasOnly(['msg', 'stack', 'chave', 'cod', 'tela', 'acao', 'origem', 'uid', 'versao', 'aparelho', 'telaPx', 'pwa', 'em', 'expiraEm'])
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 500
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 2000
        && request.resource.data.aparelho is string && request.resource.data.aparelho.size() <= 250
        && request.resource.data.tela is string && request.resource.data.tela.size() <= 80
        && request.resource.data.acao is string && request.resource.data.acao.size() <= 120
        && request.resource.data.em is int
        && request.resource.data.expiraEm is timestamp;
      allow read, delete: if donoDoApp();
      allow update: if false;
    }
    match /servidor/{doc} {
      allow read, write: if false;
    }

    // Código do convite → pelada. Qualquer pessoa logada pode procurar um código.
    match /codigos/{codigo} {
      allow read: if logado();
      allow create: if logado() && adminDepois(request.resource.data.gid);
      allow update, delete: if logado() && admin(resource.data.gid);
    }

    // A pelada (nome, dia, administradores, código).
    match /grupos/{gid} {
      allow read: if logado();
      allow create: if logado()
        && request.resource.data.dono == eu()
        && request.resource.data.admins == [eu()];
      allow update: if admin(gid)
        && request.resource.data.dono == resource.data.dono
        && request.resource.data.dono in request.resource.data.admins
        && request.resource.data.admins.size() > 0
        // o representante que trouxe o grupo não muda depois de criado
        && request.resource.data.get('rep', null) == resource.data.get('rep', null);
      allow delete: if logado() && resource.data.dono == eu();

      // Quem entrou na pelada. A pessoa entra sozinha se souber o código.
      match /membros/{uid} {
        allow read: if membro(gid) || admin(gid);
        allow create, update: if logado() && (
          (eu() == uid && request.resource.data.codigo == grupoDepois(gid).codigo)
          || adminDepois(gid));
        allow delete: if admin(gid) || (logado() && eu() == uid);
      }

      // Presença, vínculo com o elenco e avaliação do campo: cada um mexe no seu.
      match /presencas/{uid} {
        allow read: if membro(gid) || admin(gid);
        // O jogador mexe na própria presença, mas não escolhe quem ele é: o vínculo com o elenco é do administrador.
        allow write: if admin(gid) || (logado() && eu() == uid && membro(gid)
          && resource != null && request.resource.data.jogador == resource.data.jogador);
      }

      // Avaliação pós-jogo (secreta): cada um lê e grava só o próprio voto.
      // Os administradores leem para apurar a média quando a avaliação fecha.
      match /votos/{uid} {
        allow read: if (logado() && eu() == uid) || admin(gid);
        allow write: if logado() && eu() == uid && membro(gid);
      }

      // Chave do Mercado Pago do grupo: só o servidor lê e grava (conexão pelo botão "Conectar").
      match /segredos/{doc} {
        allow read, write: if false;
      }

      // Cobranças Pix: o servidor cria; cada membro lê (para ver o QR e o status).
      match /cobrancas/{doc} {
        allow read: if membro(gid) || admin(gid);
        allow write: if false;
      }

      // Todo o resto (elenco, peladas, caixa, avisos, locais, ajustes, mural, notificações):
      // membros leem, só administradores escrevem.
      match /{colecao}/{doc} {
        allow read: if colecao != 'votos' && colecao != 'segredos' && (membro(gid) || admin(gid));
        allow write: if colecao != 'membros' && colecao != 'presencas' && colecao != 'votos' && colecao != 'segredos' && colecao != 'cobrancas' && adminDepois(gid);
      }
    }
  }
}
